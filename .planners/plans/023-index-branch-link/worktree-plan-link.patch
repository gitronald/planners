 # What the Worktree field says when the work happens in the main checkout.
@@ -75,28 +76,46 @@ def activation_entry(
     base: str | None,
     sha: str | None,
     worktree: str,
+    plan: str,
     pr: str | None,
 ) -> str:
     """The entry ``activate`` writes: where the work will happen.
 
     ``base`` is the branch the activation is committed on and ``sha`` the commit
     it sits on, HEAD before the activation commit. Either can be unknown: a
-    detached HEAD has no branch, and an unborn one has no commit.
+    detached HEAD has no branch, and an unborn one has no commit. ``plan`` is the
+    plan file's repo-relative path; with a worktree, the entry links that plan's
+    copy inside it.
     """
     if base is None:
         where = "a detached HEAD"
     else:
         where = f"`{base}`"
     where += f" at `{sha}`" if sha else " (no commits yet)"
-    return "\n".join(
-        [
-            _stamp(when, "Activated."),
-            f"  - Branch: `{branch}`",
-            f"  - Base: {where}",
-            f"  - Worktree: {worktree if worktree == NO_WORKTREE else f'`{worktree}`'}",
-            f"  - PR: {pr or 'pending'}",
-        ]
-    )
+    lines = [
+        _stamp(when, "Activated."),
+        f"  - Branch: `{branch}`",
+        f"  - Base: {where}",
+    ]
+    if worktree == NO_WORKTREE:
+        lines.append(f"  - Worktree: {NO_WORKTREE}")
+    else:
+        lines.append(f"  - Worktree: `{worktree}`")
+        lines.append(f"  - WorktreePlan: {worktree_plan_link(worktree, plan)}")
+    lines.append(f"  - PR: {pr or 'pending'}")
+    return "\n".join(lines)
+
+
+def worktree_plan_link(worktree: str, plan: str) -> str:
+    """A Markdown link to ``plan``'s copy inside ``worktree``.
+
+    The text is the path from the repo root. The target is relative to the plan
+    file the entry is written in, which is how editors and GitHub resolve a
+    link, so it opens from the main checkout's copy of the plan.
+    """
+    target = f"{worktree.strip().rstrip('/')}/{plan}"
+    ups = "../" * (len(PurePosixPath(plan).parts) - 1)
+    return f"[`{target}`]({ups}{target})"
 
 
